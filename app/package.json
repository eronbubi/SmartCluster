{
  "name": "smartcluster-app",
  "private": true,
  "version": "0.1.0",
  "description": "SmartCluster control app: web UI and Electron shell",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "gen:api": "openapi-typescript ../docs/api/openapi.yaml -o src/api/schema.d.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.electron.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "embed": "node scripts/embed.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.2",
    "i18next": "26.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.0.16",
    "react-router": "8.4.0",
    "uplot": "1.6.32"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
